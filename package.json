{
  "name": "pixi-solid-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "pnpm readme:verify && pnpm -r run test",
    "readme:sync": "node scripts/sync-readme.mjs",
    "readme:verify": "node scripts/sync-readme.mjs --check",
    "preinstall": "npx only-allow pnpm",
    "lint": "oxlint",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "sass-embedded": "1.100.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "pixi.js": "8.19.0",
      "solid-js": "1.9.14"
    }
  }
}
